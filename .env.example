# ─── Banco (docker compose up -d postgres) ───────────────────────────────
DATABASE_URL="postgresql://casamento:casamento_dev@localhost:5432/casamento?schema=public"

# ─── Storage S3-compatible ──────────────────────────────────────────────
# Local: MinIO do compose. Producao: trocar pelos valores do Cloudflare R2
#   S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   S3_FORCE_PATH_STYLE=false
#   NEXT_PUBLIC_MEDIA_URL=https://fotos.seudominio.com   (dominio publico do bucket)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="casamento-fotos"
S3_FORCE_PATH_STYLE="true"

# URL publica de leitura das fotos (vai pro <img src>, precisa do prefixo NEXT_PUBLIC_)
NEXT_PUBLIC_MEDIA_URL="http://localhost:9000/casamento-fotos"

# ─── Painel de moderacao (/admin) ───────────────────────────────────────
ADMIN_PASSWORD="troque-esta-senha"
